# Dependencies
node_modules/

# Build output (electron-builder)
dist/

# Generated by `npm run icons` (scripts/make-icons.js); the dist scripts and CI regenerate them.
# build/entitlements.mac.plist and build/installer.nsh ARE source files and stay tracked.
build/icon.png
build/icon.ico
build/icons/

# Logs
*.log
npm-debug.log*

# Local environment / editor state
.env
.env.*
.vscode/
.idea/
*.swp

# OS junk
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Flutter mobile viewer (mobile/). Build outputs and machine-specific files.
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.idea/
mobile/*.iml
mobile/android/.gradle/
mobile/android/.kotlin/
mobile/android/build/
mobile/android/app/build/
mobile/android/app/.cxx/
mobile/android/local.properties
mobile/android/gradlew
mobile/android/gradlew.bat
mobile/android/gradle/wrapper/gradle-wrapper.jar
mobile/android/**/GeneratedPluginRegistrant.java
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/ephemeral/
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/Runner/GeneratedPluginRegistrant.*
mobile/ios/build/
mobile/ios/**/xcuserdata/

# Signing material must never be committed (keys live only in GitHub secrets).
key.properties
*.jks
*.p12
*.keystore
